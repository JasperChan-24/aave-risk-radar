# Ethereum mainnet RPC. Archive access is required to rebuild historical
# Aave-oracle calibration data; latest-state portfolio reads work without it.
ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional dedicated archive endpoint used by scripts/capture_history.py.
ETHEREUM_ARCHIVE_RPC_URL=

# Optional read-only firm-pricing provider. Transaction calldata is discarded;
# deterministic assumption mode remains available when this key is absent.
ZEROX_API_KEY=

# Optional override for the Ethereum Aave V3 PoolAddressesProvider.
AAVE_V3_POOL_ADDRESSES_PROVIDER=0x2f39d218133AFaB8F2B819B1066c7E434Ad94E9e

# Reproducibility and reconciliation settings.
SNAPSHOT_DIRECTORY=snapshots
HF_RECONCILIATION_TOLERANCE_BPS=5
